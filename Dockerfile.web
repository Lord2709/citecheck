# CiteCheck website: React frontend + FastAPI backend + the evaluated model, in one container.
# Google Cloud Run (deploy/GCP.md), a Hugging Face Docker Space or any Docker host.  Owner: Engineering.  Setup: deploy/WEB.md.

# ---- stage 1: build the React site ----
FROM node:20-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

# ---- stage 2: API + model ----
FROM python:3.11-slim
RUN useradd -m -u 1000 user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/home/user/.cache/huggingface
WORKDIR /home/user/app

COPY --chown=user requirements.txt .
# CPU-only PyTorch first (the same version requirements.txt pins), then everything else.
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch==2.8.0 \
 && pip install -r requirements.txt

COPY --chown=user . .
COPY --chown=user --from=web /web/dist ./web/dist
USER user
# Bake the data and the verifier model into the image so the site starts fast.
RUN python -m data.fetch_scifact \
 && python -c "from src.nli import build_verifier; build_verifier('nli')._load()"

EXPOSE 7860
CMD ["uvicorn", "--factory", "api.main:create_app", "--host", "0.0.0.0", "--port", "7860", "--proxy-headers"]
